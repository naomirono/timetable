# Your production domain, no trailing slash. Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
# Optional: Google Analytics 4 measurement ID (free custom event tracking)
NEXT_PUBLIC_GA_ID=
# Optional: Google Search Console HTML-tag verification code (the content="..." value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
